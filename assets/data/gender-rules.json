[
  {
    "id": "rule_der_er",
    "gender": "der",
    "kind": "ending",
    "pattern": "-er",
    "explanation": "Sustantivos terminados en -er que designan profesiones o personas suelen ser masculinos.",
    "examples": ["Lehrer", "Schüler"],
    "exceptions": []
  },
  {
    "id": "rule_der_or",
    "gender": "der",
    "kind": "ending",
    "pattern": "-or",
    "explanation": "Sustantivos terminados en -or (a menudo de origen latino) son masculinos.",
    "examples": ["Professor"],
    "exceptions": []
  },
  {
    "id": "rule_der_alkohol",
    "gender": "der",
    "kind": "semantic",
    "pattern": "alcoholes",
    "explanation": "El 90% de las bebidas alcohólicas son der.",
    "examples": ["Wein", "Wodka", "Schnaps"],
    "exceptions": ["Bier"]
  },
  {
    "id": "rule_der_himmelsrichtung",
    "gender": "der",
    "kind": "semantic",
    "pattern": "puntos cardinales",
    "explanation": "Los puntos cardinales son siempre der.",
    "examples": ["Norden", "Süden", "Osten", "Westen"],
    "exceptions": []
  },
  {
    "id": "rule_die_e",
    "gender": "die",
    "kind": "ending",
    "pattern": "-e",
    "explanation": "El 80% de las palabras terminadas en -e son femeninas.",
    "examples": ["Tomate", "Limonade"],
    "exceptions": ["Käse"]
  },
  {
    "id": "rule_die_ung",
    "gender": "die",
    "kind": "ending",
    "pattern": "-ung",
    "explanation": "Sustantivos terminados en -ung son femeninos.",
    "examples": ["Zeitung", "Wohnung"],
    "exceptions": []
  },
  {
    "id": "rule_die_heit_keit",
    "gender": "die",
    "kind": "ending",
    "pattern": "-heit/-keit",
    "explanation": "Sustantivos terminados en -heit o -keit son femeninos.",
    "examples": ["Krankheit"],
    "exceptions": []
  },
  {
    "id": "rule_das_chen",
    "gender": "das",
    "kind": "ending",
    "pattern": "-chen",
    "explanation": "El diminutivo -chen siempre es neutral, sin importar el género de la palabra base.",
    "examples": ["Mädchen", "Hähnchen"],
    "exceptions": []
  },
  {
    "id": "rule_das_o",
    "gender": "das",
    "kind": "ending",
    "pattern": "-o",
    "explanation": "Muchas palabras terminadas en -o (a menudo préstamos) son neutrales.",
    "examples": ["Auto"],
    "exceptions": []
  },
  {
    "id": "rule_das_fremdwort",
    "gender": "das",
    "kind": "semantic",
    "pattern": "préstamos extranjeros",
    "explanation": "Palabras importadas de otros idiomas tienden a ser neutrales.",
    "examples": ["Sushi"],
    "exceptions": []
  },
  {
    "id": "rule_der_and_ent",
    "gender": "der",
    "kind": "ending",
    "pattern": "-and/-ent",
    "explanation": "Sustantivos de persona terminados en -and o -ent (participantes/estudiantes) son masculinos.",
    "examples": ["Student", "Doktorand"],
    "exceptions": []
  },
  {
    "id": "rule_das_metall",
    "gender": "das",
    "kind": "semantic",
    "pattern": "metales",
    "explanation": "Los metales (oro, plata, hierro) casi siempre son neutrales.",
    "examples": ["Gold", "Silber", "Eisen"],
    "exceptions": []
  },
  {
    "id": "rule_der_ismus",
    "gender": "der",
    "kind": "ending",
    "pattern": "-ismus",
    "explanation": "Sustantivos abstractos terminados en -ismus (corrientes, ideologías, fenómenos) son siempre masculinos.",
    "examples": ["Optimismus", "Tourismus", "Kapitalismus"],
    "exceptions": []
  },
  {
    "id": "rule_der_ist",
    "gender": "der",
    "kind": "ending",
    "pattern": "-ist",
    "explanation": "El sufijo -ist designa personas (profesión o adscripción) y es masculino. El femenino se forma con -istin.",
    "examples": ["Polizist", "Journalist", "Tourist"],
    "exceptions": ["die Frist"]
  },
  {
    "id": "rule_der_ig",
    "gender": "der",
    "kind": "ending",
    "pattern": "-ig",
    "explanation": "Sustantivos terminados en -ig son masculinos.",
    "examples": ["Honig", "König", "Essig"],
    "exceptions": ["das Reisig"]
  },
  {
    "id": "rule_der_ling",
    "gender": "der",
    "kind": "ending",
    "pattern": "-ling",
    "explanation": "El sufijo -ling es masculino sin excepciones, incluso cuando la palabra base es femenina o neutra.",
    "examples": ["Schmetterling", "Frühling", "Lehrling"],
    "exceptions": []
  },
  {
    "id": "rule_der_en",
    "gender": "der",
    "kind": "ending",
    "pattern": "-en",
    "explanation": "Muchos sustantivos terminados en -en son masculinos y tienen plural idéntico al singular. Regla con menos fuerza que las demás.",
    "examples": ["Schinken", "Garten", "Wagen"],
    "exceptions": ["das Essen", "das Leben"]
  },
  {
    "id": "rule_der_ich",
    "gender": "der",
    "kind": "ending",
    "pattern": "-ich",
    "explanation": "Sustantivos terminados en -ich son masculinos.",
    "examples": ["Teppich", "Rettich", "Kranich"],
    "exceptions": []
  },
  {
    "id": "rule_der_eur",
    "gender": "der",
    "kind": "ending",
    "pattern": "-eur",
    "explanation": "Sufijo de origen francés que designa personas por su oficio; siempre masculino. Femenino en -eurin.",
    "examples": ["Ingenieur", "Friseur", "Regisseur"],
    "exceptions": []
  },
  {
    "id": "rule_der_iker",
    "gender": "der",
    "kind": "ending",
    "pattern": "-iker",
    "explanation": "Designa a la persona que practica una disciplina (Mechanik → Mechaniker). Siempre masculino, plural idéntico al singular.",
    "examples": ["Mechaniker", "Musiker", "Politiker"],
    "exceptions": []
  }
]
